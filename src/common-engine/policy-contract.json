{
  "format": "common-vocab-engine-policy-contract/v1",
  "status": "contract-only-no-runtime-wiring",
  "masterRepository": "FYam8/english-vocab",
  "engineCandidateStatus": "mixed-not-exportable",
  "purpose": "Define the school-neutral engine boundary after pure-helper extraction, without changing Waseda production behavior or replacing Rikkyo's existing FSRS/storage architecture.",
  "principles": [
    "The common engine must not own a school's storage key, database name, cloud endpoint, app id, export format, branding, score-band names, UI copy, or migration rules.",
    "Scheduler strategy is injected. Waseda's current forgetting-curve model and Rikkyo's FSRS-6 model are separate valid adapter implementations; neither scheduler is silently reinterpreted as the other.",
    "Item identity is supplied by the school adapter and remains stable. The common engine must not rewrite Waseda vocabulary ids or Rikkyo rik-* stable ids.",
    "Question and planning behavior may share orchestration, but school-specific modes, score bands, study-layer meanings, priority policy, challenge policy and retry spacing remain adapter policy until explicitly normalized.",
    "Persistence and cloud synchronization are separate boundaries from learning-policy extraction.",
    "UI explanation strings remain outside the common engine."
  ],
  "interfaces": {
    "entityAdapter": {
      "requiredCapabilities": [
        "getStableId",
        "isQuizEligible",
        "getQuestionCapabilities"
      ],
      "optionalSignals": [
        "prioritySignal",
        "studyLaneSignal",
        "scheduleTags",
        "frequencySignal"
      ],
      "engineMustNotRequireRawFields": [
        "priority",
        "level",
        "studyLayer",
        "yearCount",
        "frequency"
      ]
    },
    "memorySchedulerAdapter": {
      "requiredMethods": [
        "getDueAt",
        "isDue",
        "applyOutcome",
        "urgencyScore"
      ],
      "schedulerStateIsOpaqueToEngine": true,
      "engineMustNotInterpret": [
        "Waseda memoryModel object",
        "Rikkyo ts-fsrs Card object"
      ]
    },
    "planningPolicy": {
      "requiredMethods": [
        "eligibleForMode",
        "scoreCandidate",
        "buildSpecialPlan",
        "retryDecision"
      ],
      "engineOwns": [
        "generic weighted selection orchestration",
        "generic queue traversal orchestration once school state has been adapted"
      ],
      "adapterOwns": [
        "mode semantics",
        "priority weights",
        "challenge/foundation policy",
        "retry spacing",
        "school-facing reason text"
      ]
    },
    "timePolicy": {
      "requiredMethods": [
        "now",
        "learningDayId"
      ],
      "engineMustNotHardCodeTimeZone": true
    }
  },
  "wasedaCurrentMapping": {
    "persistenceOwnedElsewhere": [
      "WASEDA_APP_CONFIG",
      "wasedaMigrateState",
      "waseshibu_vocab_state",
      "waseshibu_vocab_active_session_v1",
      "progress-sync.js"
    ],
    "memorySchedulerPolicy": {
      "symbols": [
        "v76TargetRetention",
        "v76ReviewIntervalDays",
        "v76UpdateMemoryAfterOutcome",
        "schedulerScore v7.6 override"
      ],
      "retention": {
        "default": 0.9,
        "prioritySOrWeak": 0.92,
        "prioritySAndWeak": 0.93
      },
      "reviewIntervalBoundsDays": [0.75, 60],
      "retryCorrectIntervalDays": 1,
      "missIntervalMinutes": 15,
      "mustRemainBehaviorallyIdenticalDuringAdapterIntroduction": true
    },
    "planningPolicy": {
      "symbols": [
        "v75ChallengeScore",
        "v75FoundationReason",
        "buildChallengeSessionPlan",
        "buildSessionPlan",
        "v75DueRetry",
        "v75PickUnlimitedBase",
        "v75NextSessionItem"
      ],
      "knownSchoolAssumptions": [
        "60/70/75 score bands",
        "S/A/B/C priority",
        "core/diagnostic/challenge/reference studyLayer",
        "75-point challenge mode",
        "Japanese Waseda-facing reason strings"
      ]
    }
  },
  "rikkyoAuditedMapping": {
    "repository": "FYam8/rikkyo-uk-vocab",
    "auditedCommit": "06eb47656bf0066af5cfe2072a53cfcdd42e5232",
    "scheduler": {
      "algorithm": "FSRS-6",
      "package": "ts-fsrs",
      "packageVersion": "5.4.2",
      "desiredRetention": 0.9,
      "enableFuzz": false,
      "enableShortTerm": false,
      "currentFunctions": [
        "newCard",
        "schedule",
        "applyStudyAnswer"
      ],
      "mustNotBeReplacedByWasedaMemoryModel": true
    },
    "learningIdentity": "stableId x skillKey",
    "skillKeys": [
      "meaningRecognition",
      "formProduction"
    ],
    "stages": [
      "learning",
      "review",
      "relearning",
      "provisional",
      "acquisitionCandidate"
    ],
    "lanes": [
      "learning",
      "relearning",
      "provisional",
      "review",
      "acquisition"
    ],
    "planningFunctions": [
      "buildQueue",
      "ensurePlan"
    ],
    "persistenceMustRemainSchoolSpecific": true
  },
  "forbiddenCommonEngineAssumptions": [
    "waseshibu_",
    "rikkyo-uk-vocab",
    "priority === S",
    "mode === 75",
    "studyLayer === challenge",
    "studyLayer === diagnostic",
    "Europe/London as an engine default",
    "Japanese school-facing explanation text",
    "direct localStorage access",
    "direct IndexedDB database names",
    "cloud API endpoints",
    "cross-school export acceptance"
  ],
  "firstRuntimeBoundary": {
    "name": "memory-scheduler-policy-adapter",
    "status": "blocked-until-contract-exact-head-green",
    "scope": [
      "v76TargetRetention",
      "v76ReviewIntervalDays",
      "v76UpdateMemoryAfterOutcome",
      "memory-related part of the v7.6 schedulerScore override"
    ],
    "implementationOrder": [
      "Introduce a Waseda memory-policy adapter that returns the exact current Waseda values and does not change persistence.",
      "Make the current Waseda memory runtime delegate to that adapter while preserving function outputs and state writes.",
      "Run branch-head and synthetic-merge two-pass existing-user parity and ownership gates.",
      "Define the common scheduler-adapter surface around opaque scheduler state.",
      "Map Rikkyo FSRS-6 to that surface without changing its Card state, stages, learning steps or desired retention."
    ],
    "forbiddenFirstStep": [
      "moving v76TargetRetention directly into the common engine with S-priority logic",
      "making Rikkyo use Waseda memoryModel",
      "making Waseda use ts-fsrs during this boundary step",
      "changing Waseda schemaVersion or localStorage keys",
      "changing Rikkyo stableId x skillKey identity",
      "changing either public deployment"
    ]
  },
  "gates": {
    "runtimeWiringAllowedBeforeContractGreen": false,
    "requireExactBranchHead": true,
    "requireSyntheticMerge": true,
    "requireTwoPassCompatibility": true,
    "requireOwnershipGuard": true,
    "requireWasedaProductionMainUnchanged": true
  }
}
