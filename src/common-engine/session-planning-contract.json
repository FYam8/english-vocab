    "dueBoost": 115,
    "recentMistakeBoost": 80,
    "weakBoost": 95,
    "mastery4NotDueSuppressionMultiplier": 0.12,
    "memoryBoostOwnedBy": "WASEDA_MEMORY_POLICY.applyChallengeMemoryScore",
