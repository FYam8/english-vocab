    "gapAnswersOther": 8,
    "dueAt": "session.totalAnswered + gap after incrementing totalAnswered for the miss",
    "retryMiss": "remove retry and block word for rest of session",
    "retryCorrect": "remove retry and unblock word",
    "dueRetryEligibility": "dueAfterTotal<=session.totalAnswered AND wordId not blocked",
